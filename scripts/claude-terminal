#!/bin/bash
set -euo pipefail

DIR=""
CLAUDE_OPTIONS=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dir)
            DIR="$2"
            shift 2
            ;;
        --dir=*)
            DIR="${1#--dir=}"
            shift
            ;;
        --claude-options)
            CLAUDE_OPTIONS="$2"
            shift 2
            ;;
        --claude-options=*)
            CLAUDE_OPTIONS="${1#--claude-options=}"
            shift
            ;;
        -h|--help)
            echo "Usage: claude-terminal [--dir <path>] [--claude-options <options>]"
            echo ""
            echo "Launch Claude Terminal in a directory with optional Claude CLI flags."
            echo ""
            echo "Options:"
            echo "  --dir <path>              Working directory (default: current directory)"
            echo "  --claude-options <options> Options passed to the claude CLI"
            echo "  -h, --help                Show this help"
            exit 0
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Run 'claude-terminal --help' for usage." >&2
            exit 1
            ;;
    esac
done

if [[ -z "$DIR" ]]; then
    DIR="$PWD"
fi

# Resolve to absolute path
DIR="$(cd "$DIR" && pwd)"

url_encode() {
    python3 -c "import urllib.parse, sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$1"
}

URL="claude-terminal://open?dir=$(url_encode "$DIR")"
if [[ -n "$CLAUDE_OPTIONS" ]]; then
    URL="${URL}&claude-options=$(url_encode "$CLAUDE_OPTIONS")"
fi

open "$URL"
